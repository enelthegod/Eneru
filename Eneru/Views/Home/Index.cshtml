@model List<Eneru.Models.Product>

@{
    ViewData["Title"] = "Eneru — Modern Fashion";
}

<!-- Hero Section -->
<div style="background:#111; color:white; padding:6rem 0; margin-top:-1.5rem;">
    <div class="container text-center">
        <p class="text-uppercase mb-2"
               style="letter-spacing:4px; font-size:0.8rem; color:#aaa;">
            New Collection 2026
        </p>
        <h1 class="fw-bold mb-4"
            style="font-size:3.5rem; letter-spacing:2px;">
            DEFINE YOUR STYLE
        </h1>
        <p class="mb-5" style="color:#aaa; max-width:500px; margin:0 auto 2rem;">
            Curated fashion from the world's leading brands.
            Discover pieces that speak to you.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="/Products" class="btn btn-light px-5 py-2"
                   style="text-transform:uppercase; letter-spacing:1px; border-radius:0;">
                Shop Now
            </a>
            <a href="/Products?category=shoes" class="btn btn-outline-light px-5 py-2"
                   style="text-transform:uppercase; letter-spacing:1px; border-radius:0;">
                Shoes
            </a>
        </div>
    </div>
</div>

<!-- Category Strips -->
<div class="container my-5">
    <div class="row g-3">
        <div class="col-md-4">
            <a href="/Products?category=tops" class="text-decoration-none">
                <div class="p-4 text-center"
                     style="background:#f5f5f5; transition:background 0.2s;"
                     onmouseover="this.style.background='#ebebeb'"
                     onmouseout="this.style.background='#f5f5f5'">
                    <i class="bi bi-person" style="font-size:2rem;"></i>
                    <p class="mb-0 mt-2 fw-bold text-uppercase"
                       style="letter-spacing:1px; font-size:0.85rem;">Tops</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Products?category=shoes" class="text-decoration-none">
                <div class="p-4 text-center"
                     style="background:#f5f5f5; transition:background 0.2s;"
                     onmouseover="this.style.background='#ebebeb'"
                     onmouseout="this.style.background='#f5f5f5'">
                    <i class="bi bi-lightning" style="font-size:2rem;"></i>
                    <p class="mb-0 mt-2 fw-bold text-uppercase"
                       style="letter-spacing:1px; font-size:0.85rem;">Shoes</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Products?category=accessories" class="text-decoration-none">
                <div class="p-4 text-center"
                     style="background:#f5f5f5; transition:background 0.2s;"
                     onmouseover="this.style.background='#ebebeb'"
                     onmouseout="this.style.background='#f5f5f5'">
                    <i class="bi bi-bag" style="font-size:2rem;"></i>
                    <p class="mb-0 mt-2 fw-bold text-uppercase"
                       style="letter-spacing:1px; font-size:0.85rem;">Accessories</p>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Featured Products -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-uppercase mb-0" style="letter-spacing:2px;">
            Featured
        </h5>
        <a href="/Products" class="text-muted text-decoration-none"
               style="font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card product-card h-100">
                    <img src="@product.ImageUrl"
                         alt="@product.Name"
                         class="card-img-top" />
                    <div class="card-body">
                        <p class="text-muted mb-1" style="font-size:0.8rem;">
                            @product.Brand
                        </p>
                        <h6 class="card-title mb-1">@product.Name</h6>
                        <p class="fw-bold mb-3">$@product.Price.ToString("0.00")</p>
                        <a href="/Products/Details/@product.Id"
                               class="btn btn-dark w-100">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Banner -->
<div style="background:#111; color:white; padding:4rem 0;" class="mb-0">
    <div class="container text-center">
        <h4 class="fw-bold text-uppercase mb-2" style="letter-spacing:3px;">
            Free Shipping
        </h4>
        <p style="color:#aaa; font-size:0.9rem;">
            On all orders over $150 — worldwide delivery
        </p>
        <a href="/Products" class="btn btn-outline-light mt-2"
               style="border-radius:0; text-transform:uppercase; letter-spacing:1px;">
            Shop Now
        </a>
    </div>
</div>