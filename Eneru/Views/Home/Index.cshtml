@model List<Eneru.Models.Product>

@{
    ViewData["Title"] = "Eneru — Modern Fashion";
}

<!-- HERO -->
<div style="background:var(--black); color:white; min-height:90vh; display:flex; align-items:center;">
    <div class="container text-center">
        <p style="font-size:0.7rem; text-transform:uppercase; letter-spacing:6px; color:#888; margin-bottom:2rem;">
            Spring / Summer 2026
        </p>
        <h1 style="font-family:'Cormorant Garamond',serif; font-size:clamp(3rem,8vw,7rem); font-weight:300; letter-spacing:8px; line-height:1; margin-bottom:2rem;">
            THE NEW<br>COLLECTION
        </h1>
        <p style="color:#aaa; font-size:0.85rem; letter-spacing:2px; max-width:400px; margin:0 auto 3rem; line-height:2;">
            Elevated essentials for the modern wardrobe
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/Products" class="btn-eneru">Explore Now</a>
            <a href="/Products?category=shoes" class="btn-eneru-outline">New Shoes</a>
        </div>
    </div>
</div>

<!-- MARQUEE STRIP — scrolling text like luxury brands use -->
<div style="background:var(--black); border-top:1px solid #222; border-bottom:1px solid #222; padding:12px 0; overflow:hidden;">
    <div style="white-space:nowrap; animation: marquee 20s linear infinite; display:inline-block;">
        @for (int i = 0; i < 4; i++)
        {
            <span style="font-size:0.65rem; letter-spacing:4px; text-transform:uppercase; color:#555; padding:0 3rem;">
                Free Shipping Over $150
            </span>
            <span style="color:#333;">◆</span>
            <span style="font-size:0.65rem; letter-spacing:4px; text-transform:uppercase; color:#555; padding:0 3rem;">
                New Collection 2026
            </span>
            <span style="color:#333;">◆</span>
            <span style="font-size:0.65rem; letter-spacing:4px; text-transform:uppercase; color:#555; padding:0 3rem;">
                Worldwide Delivery
            </span>
            <span style="color:#333;">◆</span>
        }
    </div>
</div>

<!-- CSS animation for marquee — inline because it uses keyframes -->
<style>
    @@keyframes marquee {

        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }
</style>

<!-- CATEGORY GRID -->
<div class="container" style="padding:5rem 1rem;">
    <p style="font-size:0.7rem; text-transform:uppercase; letter-spacing:4px; text-align:center; margin-bottom:3rem; color:var(--grey-text);">
        Shop by Category
    </p>
    <div class="row g-2">
        <div class="col-md-6">
            <a href="/Products?category=tops" class="text-decoration-none d-block position-relative overflow-hidden"
               style="background:var(--grey-light); height:400px;">
                <div style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:2rem;">
                    <p style="font-size:0.65rem; text-transform:uppercase; letter-spacing:3px; color:var(--grey-text); margin-bottom:4px;">
                        Collection
                    </p>
                    <h3 style="font-family:'Cormorant Garamond',serif; font-size:2.2rem; color:var(--black); margin:0;">
                        Tops
                    </h3>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <div class="row g-2">
                <div class="col-6">
                    <a href="/Products?category=bottoms" class="text-decoration-none d-block position-relative overflow-hidden"
                       style="background:#e8e8e8; height:194px;">
                        <div style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:1.5rem;">
                            <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; color:var(--black); margin:0;">
                                Bottoms
                            </h3>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/Products?category=shoes" class="text-decoration-none d-block position-relative overflow-hidden"
                       style="background:#ddd; height:194px;">
                        <div style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:1.5rem;">
                            <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; color:var(--black); margin:0;">
                                Shoes
                            </h3>
                        </div>
                    </a>
                </div>
                <div class="col-12">
                    <a href="/Products?category=accessories" class="text-decoration-none d-block position-relative overflow-hidden"
                       style="background:#e0ddd8; height:194px;">
                        <div style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:1.5rem;">
                            <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; color:var(--black); margin:0;">
                                Accessories
                            </h3>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FEATURED PRODUCTS -->
<div style="padding:0 1rem 5rem;">
    <div style="max-width:1400px; margin:0 auto;">
        <div class="d-flex justify-content-between align-items-baseline mb-4" style="padding:0 0.5rem;">
            <h2 style="font-family:'Cormorant Garamond',serif; font-size:2rem; font-weight:400; letter-spacing:2px;">
                Featured
            </h2>
            <a href="/Products" style="font-size:0.7rem; text-transform:uppercase; letter-spacing:2px; color:var(--black); text-decoration:none; border-bottom:1px solid var(--black); padding-bottom:2px;">
                View All
            </a>
        </div>

        <!-- 4 columns on desktop, 2 on tablet, 1 on mobile -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="product-card">
                        <!-- img-wrap creates fixed aspect ratio and clips zoom -->
                        <a href="/Products/Details/@product.Id" class="text-decoration-none d-block">
                            <div class="img-wrap">
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            </div>
                        </a>
                        <div class="card-info">
                            <p class="card-brand">@product.Brand</p>
                            <p class="card-name">@product.Name</p>
                            <p class="card-price">$@product.Price.ToString("0.00")</p>
                            <a href="/Products/Details/@product.Id" class="btn-eneru" style="padding:8px 20px; font-size:0.65rem; display:block; text-align:center; margin-top:8px;">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- EDITORIAL BANNER -->
<div style="background:var(--grey-light); padding:5rem 1rem;">
    <div class="container text-center">
        <p style="font-size:0.65rem; text-transform:uppercase; letter-spacing:4px; color:var(--grey-text); margin-bottom:1rem;">
            The Eneru Promise
        </p>
        <h2 style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,3.5rem); font-weight:300; letter-spacing:3px; margin-bottom:2rem; line-height:1.2;">
            Crafted for those who<br>value authenticity
        </h2>
        <div class="row justify-content-center g-4" style="max-width:700px; margin:0 auto;">
            <div class="col-4 text-center">
                <i class="bi bi-box-seam" style="font-size:1.5rem; margin-bottom:0.5rem; display:block;"></i>
                <p style="font-size:0.65rem; text-transform:uppercase; letter-spacing:2px;">Free Shipping</p>
            </div>
            <div class="col-4 text-center">
                <i class="bi bi-arrow-return-left" style="font-size:1.5rem; margin-bottom:0.5rem; display:block;"></i>
                <p style="font-size:0.65rem; text-transform:uppercase; letter-spacing:2px;">Easy Returns</p>
            </div>
            <div class="col-4 text-center">
                <i class="bi bi-shield-check" style="font-size:1.5rem; margin-bottom:0.5rem; display:block;"></i>
                <p style="font-size:0.65rem; text-transform:uppercase; letter-spacing:2px;">Secure Payment</p>
            </div>
        </div>
    </div>
</div>