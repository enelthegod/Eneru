@model Eneru.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-2 min-vh-100 py-4" style="background:#111; color:white;">
            <p class="text-uppercase fw-bold mb-4 px-3"
                   style="letter-spacing:2px; font-size:0.8rem; color:#aaa;">
                Admin Panel
            </p>
            <ul class="list-unstyled px-3">
                <li class="mb-2">
                    <a href="/Admin"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Products"
                           class="fw-bold text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Orders"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                </li>
                <li class="mt-4">
                    <form method="post" action="/Account/Logout">
                        <button type="submit"
                                class="btn btn-outline-light btn-sm w-100">
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-md-10 py-4 px-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <a href="/Admin/Products" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h4 class="fw-bold text-uppercase mb-0" style="letter-spacing:1px;">
                    Edit Product
                </h4>
            </div>

            <div class="card border-0 shadow-sm" style="max-width:600px;">
                <div class="card-body p-4">

                    <!-- enctype="multipart/form-data" required for file upload -->
                    <form method="post" action="/Admin/EditProduct"
                          enctype="multipart/form-data">

                        <!-- Hidden field — sends product Id to controller -->
                        <!-- without this controller doesn't know which product to update -->
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label text-uppercase"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Name
                            </label>
                            <!-- value="@Model.Name" pre-fills the field with existing data -->
                            <input type="text" name="name" value="@Model.Name"
                                   required class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-uppercase"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Description
                            </label>
                            <!-- textarea doesn't have value="" — content goes between tags -->
                            <textarea name="description" rows="3"
                                      class="form-control">@Model.Description</textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col">
                                <label class="form-label text-uppercase"
                                       style="font-size:0.75rem; letter-spacing:1px;">
                                    Price
                                </label>
                                <input type="number" name="price" step="0.01"
                                       value="@Model.Price" required class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label text-uppercase"
                                       style="font-size:0.75rem; letter-spacing:1px;">
                                    Brand
                                </label>
                                <input type="text" name="brand" value="@Model.Brand"
                                       required class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-uppercase"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Category
                            </label>
                            <select name="categoryId" class="form-select">
                                @foreach (var cat in ViewBag.Categories as List<Eneru.Models.Category>)
                                {
                                    
                                    <option value="@cat.Id"
                                            selected="@(cat.Id == Model.CategoryId)">
                                        @cat.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-uppercase"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Product Image
                            </label>

                            <!-- Show current image so admin knows what's set -->
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.ImageUrl"
                                         alt="Current image"
                                         style="height:80px; width:80px; object-fit:cover; background:#f0f0f0;" />
                                    <small class="text-muted d-block mt-1">
                                        Current image
                                    </small>
                                </div>
                            }

                            <!-- Upload new file to replace current image -->
                            <input type="file" name="imageFile"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control mb-2" />

                            <!-- Or change the URL directly -->
                            <input type="text" name="imageUrl"
                                   value="@Model.ImageUrl"
                                   placeholder="Or paste image URL..."
                                   class="form-control" />

                            <small class="text-muted">
                                Upload new file OR change URL to update.
                                Leave blank to keep current image.
                            </small>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <!-- checkbox sends "true" when checked, nothing when unchecked -->
                                <input type="checkbox" name="isAvailable"
                                       value="true" class="form-check-input"
                                       id="isAvailable"
                                @(Model.IsAvailable ? "checked" : "") />
                                <label class="form-check-label text-uppercase"
                                       for="isAvailable"
                                       style="font-size:0.75rem; letter-spacing:1px;">
                                    Available for sale
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-dark px-4"
                                    style="text-transform:uppercase; letter-spacing:1px;">
                                Save Changes
                            </button>
                            <a href="/Admin/Products"
                                   class="btn btn-outline-dark px-4"
                                   style="text-transform:uppercase; letter-spacing:1px;">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>