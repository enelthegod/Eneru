@model Eneru.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex" style="min-height:100vh;">

    <!-- Sidebar -->
    <div style="width:220px; min-width:220px; background:var(--black);
        padding:2rem 0; position:sticky; top:0; height:100vh;">
        <p style="font-size:0.62rem; text-transform:uppercase; letter-spacing:3px;
            color:#555; padding:0 1.5rem; margin-bottom:2rem;">
            Admin Panel
        </p>
        <nav style="display:flex; flex-direction:column;">
            <a href="/Admin"
                   style="padding:0.75rem 1.5rem; font-size:0.68rem; text-transform:uppercase;
                letter-spacing:2px; color:#888; text-decoration:none;
                border-left:2px solid transparent;">
                <i class="bi bi-grid me-2"></i> Dashboard
            </a>
            <a href="/Admin/Products"
                   style="padding:0.75rem 1.5rem; font-size:0.68rem; text-transform:uppercase;
                letter-spacing:2px; color:white; text-decoration:none;
                background:rgba(255,255,255,0.08);
                border-left:2px solid white;">
                <i class="bi bi-box me-2"></i> Products
            </a>
            <a href="/Admin/Orders"
                   style="padding:0.75rem 1.5rem; font-size:0.68rem; text-transform:uppercase;
                letter-spacing:2px; color:#888; text-decoration:none;
                border-left:2px solid transparent;">
                <i class="bi bi-receipt me-2"></i> Orders
            </a>
            <div style="padding:1.5rem; margin-top:2rem;">
                <form method="post" action="/Account/Logout">
                    <button type="submit"
                            style="background:none; border:1px solid #333; color:#888;
                        padding:8px 16px; cursor:pointer; font-size:0.62rem;
                        text-transform:uppercase; letter-spacing:2px; width:100%;
                        font-family:'Inter',sans-serif;">
                        Logout
                    </button>
                </form>
            </div>
        </nav>
    </div>

    <!-- Main content -->
    <div style="flex:1; padding:3rem;">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Admin/Products"
                   style="color:var(--grey-text); text-decoration:none;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 style="font-family:'Cormorant Garamond',serif; font-size:2rem;
                font-weight:300; letter-spacing:3px; text-transform:uppercase;
                margin:0;">
                Edit Product
            </h1>
        </div>

        <div style="max-width:560px;">
            <form method="post" action="/Admin/EditProduct"
                  enctype="multipart/form-data">
                <input type="hidden" name="id" value="@Model.Id" />

                <div style="margin-bottom:1.5rem;">
                    <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                        letter-spacing:2px; color:var(--grey-text); margin-bottom:6px;">
                        Name
                    </label>
                    <input type="text" name="name" value="@Model.Name" required
                           style="width:100%; padding:10px 0; border:none;
                    border-bottom:1px solid var(--grey-mid); outline:none;
                    font-size:0.85rem; font-family:'Inter',sans-serif;" />
                </div>

                <div style="margin-bottom:1.5rem;">
                    <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                        letter-spacing:2px; color:var(--grey-text); margin-bottom:6px;">
                        Description
                    </label>
                    <textarea name="description" rows="3"
                              style="width:100%; padding:10px; border:1px solid var(--grey-mid);
                    outline:none; font-size:0.85rem; resize:vertical;
                    font-family:'Inter',sans-serif;">@Model.Description</textarea>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col">
                        <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                            letter-spacing:2px; color:var(--grey-text); margin-bottom:6px;">
                            Price
                        </label>
                        <input type="number" name="price" step="0.01"
                               value="@Model.Price" required
                               style="width:100%; padding:10px 0; border:none;
                        border-bottom:1px solid var(--grey-mid); outline:none;
                        font-size:0.85rem; font-family:'Inter',sans-serif;" />
                    </div>
                    <div class="col">
                        <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                            letter-spacing:2px; color:var(--grey-text); margin-bottom:6px;">
                            Brand
                        </label>
                        <input type="text" name="brand" value="@Model.Brand" required
                               style="width:100%; padding:10px 0; border:none;
                        border-bottom:1px solid var(--grey-mid); outline:none;
                        font-size:0.85rem; font-family:'Inter',sans-serif;" />
                    </div>
                </div>

                <div style="margin-bottom:1.5rem;">
                    <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                        letter-spacing:2px; color:var(--grey-text); margin-bottom:6px;">
                        Category
                    </label>
                    <select name="categoryId"
                            style="width:100%; padding:10px 0; border:none;
                        border-bottom:1px solid var(--grey-mid); outline:none;
                        font-size:0.85rem; font-family:'Inter',sans-serif;
                        background:transparent; cursor:pointer;">
                        @foreach (var cat in ViewBag.Categories as List<Eneru.Models.Category>)
                        {
                            <option value="@cat.Id"
                                    selected="@(cat.Id == Model.CategoryId)">
                                @cat.Name
                            </option>
                        }
                    </select>
                </div>

                <div style="margin-bottom:1.5rem;">
                    <label style="display:block; font-size:0.62rem; text-transform:uppercase;
                        letter-spacing:2px; color:var(--grey-text); margin-bottom:8px;">
                        Product Image
                    </label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             style="width:60px; height:75px; object-fit:cover;
                        background:var(--grey-light); margin-bottom:8px;
                        display:block;" />
                    }
                    <input type="file" name="imageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           style="width:100%; font-size:0.8rem;
                    font-family:'Inter',sans-serif; margin-bottom:8px;" />
                    <input type="text" name="imageUrl" value="@Model.ImageUrl"
                           style="width:100%; padding:10px 0; border:none;
                    border-bottom:1px solid var(--grey-mid); outline:none;
                    font-size:0.82rem; font-family:'Inter',sans-serif;" />
                    <small style="font-size:0.65rem; color:var(--grey-text);">
                        Leave blank to keep current image
                    </small>
                </div>

                <div style="margin-bottom:2rem;">
                    <label style="display:flex; align-items:center; gap:0.75rem;
                        cursor:pointer; user-select:none;">
                        <input type="checkbox" name="isAvailable" value="true"
                        @(Model.IsAvailable ? "checked" : "")
                               style="width:16px; height:16px; cursor:pointer;" />
                        <span style="font-size:0.68rem; text-transform:uppercase;
                            letter-spacing:2px;">
                            Available for sale
                        </span>
                    </label>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn-eneru">
                        Save Changes
                    </button>
                    <a href="/Admin/Products" class="btn-eneru-dark-outline">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>