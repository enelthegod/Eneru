@model List<Eneru.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-2 min-vh-100 py-4" style="background:#111; color:white;">
            <p class="text-uppercase fw-bold mb-4 px-3"
                   style="letter-spacing:2px; font-size:0.8rem; color:#aaa;">
                Admin Panel
            </p>
            <ul class="list-unstyled px-3">
                <li class="mb-2">
                    <a href="/Admin"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Products"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Orders"
                           class="fw-bold text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                </li>
                <li class="mt-4">
                    <form method="post" action="/Account/Logout">
                        <button type="submit"
                                class="btn btn-outline-light btn-sm w-100">
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-md-10 py-4 px-5">
            <h4 class="fw-bold text-uppercase mb-4" style="letter-spacing:1px;">
                Orders
            </h4>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt" style="font-size:3rem; color:#ccc;"></i>
                    <p class="text-muted mt-3">No orders yet.</p>
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <p class="fw-bold mb-0">Order #@order.Id</p>
                                    <p class="text-muted mb-0" style="font-size:0.85rem;">
                                        @order.User?.Name ·
                                        @order.CreatedAt.ToString("MMMM dd, yyyy")
                                    </p>
                                </div>

                                <!-- Status update form -->
                                <form method="post" action="/Admin/UpdateOrderStatus"
                                      class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <select name="status" class="form-select form-select-sm"
                                            style="width:140px;">
                                        @foreach (var status in Enum.GetValues<Eneru.Models.OrderStatus>())
                                        {
                                            <option value="@status"
                                                    selected="@(status == order.Status)">
                                                @status
                                            </option>
                                        }
                                    </select>
                                    <button type="submit"
                                            class="btn btn-sm btn-dark"
                                            style="text-transform:uppercase; letter-spacing:1px; font-size:0.75rem;">
                                        Update
                                    </button>
                                </form>
                            </div>

                            @foreach (var item in order.OrderItems)
                            {
                                <div class="d-flex justify-content-between text-muted border-top pt-2 mt-2"
                                     style="font-size:0.85rem;">
                                    <span>@item.Product?.Name × @item.Quantity</span>
                                    <span>
                                        $@((item.PriceAtPurchase * item.Quantity).ToString("0.00"))
                                    </span>
                                </div>
                            }

                            <div class="text-end mt-2">
                                <span class="fw-bold">
                                    Total: $@order.TotalPrice.ToString("0.00")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>