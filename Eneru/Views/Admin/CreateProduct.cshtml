@{
    ViewData["Title"] = "Add Product";
}

<div style="max-width:500px; margin:2rem auto; padding:0 1rem;">
    <h2>Add New Product</h2>

    <form method="post" action="/Admin/CreateProduct">
        <div style="margin-bottom:1rem;">
            <label>Name</label><br />
            <input type="text" name="name" required style="width:100%;" />
        </div>
        <div style="margin-bottom:1rem;">
            <label>Description</label><br />
            <textarea name="description" rows="3" style="width:100%;"></textarea>
        </div>
        <div style="margin-bottom:1rem;">
            <label>Price</label><br />
            <input type="number" name="price" step="0.01" min="0" required style="width:100%;" />
        </div>
        <div style="margin-bottom:1rem;">
            <label>Brand</label><br />
            <input type="text" name="brand" required style="width:100%;" />
        </div>
        <div style="margin-bottom:1rem;">
            <label>Category</label><br />
            <select name="categoryId" style="width:100%;">
                @foreach (var cat in ViewBag.Categories as List<Eneru.Models.Category>)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div style="margin-bottom:1rem;">
            <label>Image URL</label><br />
            <input type="text" name="imageUrl"
                   placeholder="/images/placeholder.jpg" style="width:100%;" />
        </div>
        <button type="submit">Create Product</button>
        <a href="/Admin/Products" style="margin-left:1rem;">Cancel</a>
    </form>
</div>