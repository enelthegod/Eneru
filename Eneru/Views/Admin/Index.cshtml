@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-2 min-vh-100 py-4"
             style="background:#111; color:white;">
            <p class="text-uppercase fw-bold mb-4 px-3"
                   style="letter-spacing:2px; font-size:0.8rem; color:#aaa;">
                Admin Panel
            </p>
            <ul class="list-unstyled px-3">
                <li class="mb-2">
                    <a href="/Admin"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Products"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>
                <li class="mb-2">
                    <a href="/Admin/Orders"
                           class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                </li>
                <li class="mt-4">
                    <form method="post" action="/Account/Logout">
                        <button type="submit"
                                class="btn btn-outline-light btn-sm w-100">
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-md-10 py-4 px-5">
            <h4 class="fw-bold text-uppercase mb-4" style="letter-spacing:1px;">
                Dashboard
            </h4>

            <!-- Summary cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <p class="text-muted text-uppercase mb-1"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Products
                            </p>
                            <h2 class="fw-bold mb-3">@ViewBag.ProductCount</h2>
                            <a href="/Admin/Products"
                                   class="text-dark text-decoration-none"
                                   style="font-size:0.85rem;">
                                Manage <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <p class="text-muted text-uppercase mb-1"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Orders
                            </p>
                            <h2 class="fw-bold mb-3">@ViewBag.OrderCount</h2>
                            <a href="/Admin/Orders"
                                   class="text-dark text-decoration-none"
                                   style="font-size:0.85rem;">
                                Manage <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <p class="text-muted text-uppercase mb-1"
                                   style="font-size:0.75rem; letter-spacing:1px;">
                                Users
                            </p>
                            <h2 class="fw-bold mb-3">@ViewBag.UserCount</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick links -->
            <div class="d-flex gap-3">
                <a href="/Admin/CreateProduct" class="btn btn-dark"
                       style="text-transform:uppercase; letter-spacing:1px;">
                    <i class="bi bi-plus"></i> Add Product
                </a>
                <a href="/Admin/Orders" class="btn btn-outline-dark"
                       style="text-transform:uppercase; letter-spacing:1px;">
                    <i class="bi bi-receipt"></i> View Orders
                </a>
            </div>
        </div>
    </div>
</div>