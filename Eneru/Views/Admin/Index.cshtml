@{
    ViewData["Title"] = "Admin Dashboard";
}

<div style="max-width:800px; margin:2rem auto; padding:0 1rem;">
    <h2>Admin Dashboard</h2>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2rem;">
        <div style="border:1px solid #ddd; padding:1.5rem; text-align:center;">
            <h1 style="margin:0;">@ViewBag.ProductCount</h1>
            <p style="color:gray;">Products</p>
            <a href="/Admin/Products">Manage →</a>
        </div>
        <div style="border:1px solid #ddd; padding:1.5rem; text-align:center;">
            <h1 style="margin:0;">@ViewBag.OrderCount</h1>
            <p style="color:gray;">Orders</p>
            <a href="/Admin/Orders">Manage →</a>
        </div>
        <div style="border:1px solid #ddd; padding:1.5rem; text-align:center;">
            <h1 style="margin:0;">@ViewBag.UserCount</h1>
            <p style="color:gray;">Users</p>
        </div>
    </div>
</div>