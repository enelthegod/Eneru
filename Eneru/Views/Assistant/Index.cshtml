@{
    ViewData["Title"] = "Style Assistant";
}

<div style="max-width:800px; margin:0 auto; padding:2rem 1rem;">

    <!-- Header -->
    <div style="text-align:center; margin-bottom:3rem;">
        <p style="font-size:0.65rem; text-transform:uppercase;
            letter-spacing:4px; color:var(--grey-text); margin-bottom:0.5rem;">
            Powered by Gemini AI
        </p>
        <h1 style="font-family:'Cormorant Garamond',serif; font-size:2.5rem;
            font-weight:300; letter-spacing:3px;">
            Style Assistant
        </h1>
        <p style="font-size:0.82rem; color:var(--grey-text); margin-top:0.5rem;">
            Ask me anything — find products, shipping info, style advice and more.
        </p>
    </div>

    <!-- Suggested questions -->
    <div id="suggestions"
         style="display:flex; flex-wrap:wrap; gap:0.5rem;
        justify-content:center; margin-bottom:2rem;">
        <button onclick="sendSuggestion(this)"
                style="background:none; border:1px solid var(--grey-mid);
            padding:8px 16px; font-size:0.68rem; text-transform:uppercase;
            letter-spacing:1px; cursor:pointer; font-family:'Inter',sans-serif;
            transition:border-color 0.2s;"
                onmouseover="this.style.borderColor='var(--black)'"
                onmouseout="this.style.borderColor='var(--grey-mid)'">
            Find me white sneakers under $200
        </button>
        <button onclick="sendSuggestion(this)"
                style="background:none; border:1px solid var(--grey-mid);
            padding:8px 16px; font-size:0.68rem; text-transform:uppercase;
            letter-spacing:1px; cursor:pointer; font-family:'Inter',sans-serif;
            transition:border-color 0.2s;"
                onmouseover="this.style.borderColor='var(--black)'"
                onmouseout="this.style.borderColor='var(--grey-mid)'">
            What is your return policy?
        </button>
        <button onclick="sendSuggestion(this)"
                style="background:none; border:1px solid var(--grey-mid);
            padding:8px 16px; font-size:0.68rem; text-transform:uppercase;
            letter-spacing:1px; cursor:pointer; font-family:'Inter',sans-serif;
            transition:border-color 0.2s;"
                onmouseover="this.style.borderColor='var(--black)'"
                onmouseout="this.style.borderColor='var(--grey-mid)'">
            How long does shipping take?
        </button>
        <button onclick="sendSuggestion(this)"
                style="background:none; border:1px solid var(--grey-mid);
            padding:8px 16px; font-size:0.68rem; text-transform:uppercase;
            letter-spacing:1px; cursor:pointer; font-family:'Inter',sans-serif;
            transition:border-color 0.2s;"
                onmouseover="this.style.borderColor='var(--black)'"
                onmouseout="this.style.borderColor='var(--grey-mid)'">
            Show me accessories under $100
        </button>
    </div>

    <!-- Chat messages -->
    <div id="chatBox"
         style="border:1px solid var(--grey-mid); min-height:400px; max-height:500px;
        overflow-y:auto; padding:1.5rem; margin-bottom:1rem;
        display:flex; flex-direction:column; gap:1rem;">

        <!-- Initial welcome message -->
        <div style="display:flex; gap:0.75rem; align-items:flex-start;">
            <div style="width:32px; height:32px; background:var(--black); flex-shrink:0;
                display:flex; align-items:center; justify-content:center;">
                <i class="bi bi-stars" style="color:white; font-size:0.8rem;"></i>
            </div>
            <div style="background:var(--grey-light); padding:1rem;
                font-size:0.82rem; line-height:1.7; flex:1;">
                Hello! I'm your Eneru style assistant powered by Groq AI.
                I can help you find the perfect pieces, answer questions about
                shipping and returns, or give style advice. How can I help you?
            </div>
        </div>

    </div>

    <!-- Input row -->
    <div style="display:flex; border:1px solid var(--grey-mid);">
        <input type="text"
               id="messageInput"
               placeholder="Ask me anything..."
               style="flex:1; padding:14px 16px; border:none; outline:none;
        font-size:0.82rem; font-family:'Inter',sans-serif;"
               onkeydown="if(event.key==='Enter') sendMessage()" />
        <button onclick="sendMessage()"
                id="sendBtn"
                style="padding:14px 24px; background:var(--black); color:white;
            border:none; cursor:pointer; font-size:0.68rem;
            text-transform:uppercase; letter-spacing:2px;
            font-family:'Inter',sans-serif; white-space:nowrap;">
            Send
        </button>
    </div>

    <p style="font-size:0.62rem; color:var(--grey-text); text-align:center;
        margin-top:0.75rem; letter-spacing:1px;">
        AI responses may not always be accurate.
    </p>

</div>

<script>
    const chatBox     = document.getElementById('chatBox');
    const input       = document.getElementById('messageInput');
    const sendBtn     = document.getElementById('sendBtn');
    const suggestions = document.getElementById('suggestions');

    // Fill input with suggestion text and send
    function sendSuggestion(btn) {
        input.value = btn.textContent.trim();
        sendMessage();
    }

    async function sendMessage() {
        const message = input.value.trim();
        if (!message) return;

        // Hide suggestions after first interaction
        suggestions.style.display = 'none';

        appendMessage(message, 'user');
        input.value         = '';
        sendBtn.disabled    = true;
        sendBtn.textContent = '...';

        const loadingId = appendLoading();

        try {
            // POST to our controller as JSON
            // fetch() is built into every modern browser
            const res = await fetch('/Assistant/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message })
            });

            const data = await res.json();
            removeLoading(loadingId);

            appendMessage(
                data.response ?? 'Sorry, something went wrong.',
                'assistant'
            );

        } catch {
            removeLoading(loadingId);
            appendMessage('Connection error. Please try again.', 'assistant');
        }

        sendBtn.disabled    = false;
        sendBtn.textContent = 'Send';
        chatBox.scrollTop   = chatBox.scrollHeight;
    }

    function appendMessage(text, role) {
        const isUser = role === 'user';

        const wrapper = document.createElement('div');
        wrapper.style.cssText = `
            display:flex; gap:0.75rem; align-items:flex-start;
            ${isUser ? 'flex-direction:row-reverse;' : ''}
        `;

        const avatar = document.createElement('div');
        avatar.style.cssText = `
            width:32px; height:32px; flex-shrink:0;
            background:${isUser ? 'var(--grey-mid)' : 'var(--black)'};
            display:flex; align-items:center; justify-content:center;
        `;
        avatar.innerHTML = isUser
            ? '<i class="bi bi-person" style="font-size:0.8rem;"></i>'
            : '<i class="bi bi-stars" style="color:white; font-size:0.8rem;"></i>';

        const bubble = document.createElement('div');
        bubble.style.cssText = `
            padding:1rem; font-size:0.82rem; line-height:1.7; flex:1;
            background:${isUser ? 'var(--black)' : 'var(--grey-light)'};
            color:${isUser ? 'white' : 'var(--black)'};
            white-space:pre-wrap;
        `;
        // white-space:pre-wrap preserves line breaks in AI responses

        bubble.textContent = text;
        wrapper.appendChild(avatar);
        wrapper.appendChild(bubble);
        chatBox.appendChild(wrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function appendLoading() {
        const id      = 'loading-' + Date.now();
        const wrapper = document.createElement('div');
        wrapper.id    = id;
        wrapper.style.cssText = 'display:flex; gap:0.75rem; align-items:flex-start;';
        wrapper.innerHTML = `
            <div style="width:32px; height:32px; background:var(--black);
                        display:flex; align-items:center; justify-content:center;">
                <i class="bi bi-stars" style="color:white; font-size:0.8rem;"></i>
            </div>
            <div style="padding:1rem; background:var(--grey-light);
                        font-size:0.82rem; color:var(--grey-text); letter-spacing:1px;">
                Thinking...
            </div>
        `;
        chatBox.appendChild(wrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
        return id;
    }

    function removeLoading(id) {
        document.getElementById(id)?.remove();
    }
</script>