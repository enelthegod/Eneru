@{
    ViewData["Title"] = "Login";
}

<div style="min-height:70vh; display:flex; align-items:center; justify-content:center;">
    <div style="width:100%; max-width:400px; padding:0 1rem;">

        <h1 style="font-family:'Cormorant Garamond',serif; font-size:2.2rem;
            font-weight:300; letter-spacing:4px; text-transform:uppercase;
            text-align:center; margin-bottom:2.5rem;">
            Login
        </h1>

        @if (ViewBag.Error != null)
        {
            <div style="background:#fce4ec; border:1px solid #f48fb1;
                padding:12px 16px; margin-bottom:1.5rem;
                font-size:0.8rem; color:#c62828;">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Account/Login">

            <div style="margin-bottom:1.2rem;">
                <label style="display:block; font-size:0.65rem;
                    text-transform:uppercase; letter-spacing:2px;
                    margin-bottom:6px; color:var(--grey-text);">
                    Email
                </label>
                <input type="email" name="email" required
                       style="width:100%; padding:10px 0;
                border:none; border-bottom:1px solid var(--grey-mid);
                outline:none; font-size:0.85rem;
                font-family:'Inter',sans-serif; background:transparent;" />
            </div>

            <div style="margin-bottom:2rem;">
                <label style="display:block; font-size:0.65rem;
                    text-transform:uppercase; letter-spacing:2px;
                    margin-bottom:6px; color:var(--grey-text);">
                    Password
                </label>
                <input type="password" name="password" required
                       style="width:100%; padding:10px 0;
                border:none; border-bottom:1px solid var(--grey-mid);
                outline:none; font-size:0.85rem;
                font-family:'Inter',sans-serif; background:transparent;" />
            </div>

            <button type="submit" class="btn-eneru"
                    style="width:100%; padding:14px; text-align:center;
                display:block; cursor:pointer; border:none;">
                Login
            </button>

        </form>

        <p style="text-align:center; margin-top:1.5rem;
            font-size:0.72rem; color:var(--grey-text);">
            No account?
            <a href="/Account/Register"
                   style="color:var(--black); text-decoration:none;
                border-bottom:1px solid var(--black);">
                Register
            </a>
        </p>

    </div>
</div>