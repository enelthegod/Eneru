@{
    ViewData["Title"] = "Register";
}

<div class="container" style="max-width:420px;">
    <h4 class="fw-bold mb-4 text-uppercase text-center" style="letter-spacing:2px;">
        Create Account
    </h4>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" action="/Account/Register">
        <div class="mb-3">
            <label class="form-label text-uppercase"
                   style="font-size:0.75rem; letter-spacing:1px;">Name</label>
            <input type="text" name="name" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label text-uppercase"
                   style="font-size:0.75rem; letter-spacing:1px;">Email</label>
            <input type="email" name="email" required class="form-control" />
        </div>
        <div class="mb-4">
            <label class="form-label text-uppercase"
                   style="font-size:0.75rem; letter-spacing:1px;">Password</label>
            <input type="password" name="password" required class="form-control" />
        </div>
        <button type="submit" class="btn btn-dark w-100">Create Account</button>
    </form>

    <p class="text-center text-muted mt-3" style="font-size:0.85rem;">
        Already have an account? <a href="/Account/Login" class="text-dark">Login</a>
    </p>
</div>