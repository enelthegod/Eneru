@model Eneru.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<!-- Back link -->
<div style="padding:1.2rem 2rem; border-bottom:1px solid var(--grey-mid);">
    <a href="/Products"
           style="font-size:0.7rem; text-transform:uppercase; letter-spacing:2px;
        color:var(--grey-text); text-decoration:none;">
        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
    </a>
</div>

<div class="container-fluid px-0">
    <div class="row g-0">

        <!-- LEFT — Image with magnifier -->
        <div class="col-lg-7" style="border-right:1px solid var(--grey-mid);">

            <!-- Outer wrapper — position:relative so children can be positioned inside -->
            <div style="position:relative;">

                <!-- Main image container -->
                <!-- id used by JS to attach mouse events -->
                <div id="imgContainer"
                     style="position:relative; width:100%;
                    padding-top:100%;
                    overflow:hidden;
                    cursor:none;
                    background:var(--grey-light);">

                    <!-- Product image — fills the padding-top box -->
                    <img id="mainImg"
                         src="@Model.ImageUrl"
                         alt="@Model.Name"
                         style="position:absolute; top:0; left:0;
                    width:100%; height:100%;
                    object-fit:contain;
                    background:var(--grey-light);" />

                    <!-- Small lens square that follows cursor on the image -->
                    <!-- pointer-events:none so mouse events pass through it -->
                    <div id="lens"
                         style="display:none;
                        position:absolute;
                        width:100px; height:100px;
                        border:1px solid rgba(0,0,0,0.3);
                        background:rgba(255,255,255,0.2);
                        pointer-events:none;
                        transform:translate(-50%,-50%);
                        box-shadow:0 0 0 1px rgba(255,255,255,0.5);">
                    </div>

                </div>

            </div>
        </div>

        <!-- RIGHT — Product info -->
        <div class="col-lg-5"
             style="padding:3rem 2.5rem;
            position:sticky; top:104px;
            align-self:flex-start;">

            <!-- Brand -->
            <p style="font-size:0.65rem; text-transform:uppercase;
                letter-spacing:4px; color:var(--grey-text); margin-bottom:0.5rem;">
                @Model.Brand
            </p>

            <!-- Name -->
            <h1 style="font-family:'Cormorant Garamond',serif;
                font-size:2.5rem; font-weight:300;
                letter-spacing:2px; line-height:1.15;
                margin-bottom:1rem;">
                @Model.Name
            </h1>

            <!-- Category -->
            <p style="font-size:0.65rem; text-transform:uppercase;
                letter-spacing:3px; color:var(--grey-text);
                padding-bottom:1.5rem; margin-bottom:1.5rem;
                border-bottom:1px solid var(--grey-mid);">
                @Model.Category?.Name
            </p>

            <!-- Price -->
            <p style="font-size:1.6rem; font-weight:300;
                letter-spacing:2px; margin-bottom:1.5rem;">
                $@Model.Price.ToString("0.00")
            </p>

            <!-- Description -->
            <p style="font-size:0.83rem; line-height:1.9;
                color:#666; margin-bottom:2rem;">
                @Model.Description
            </p>

            <!-- Add to cart or login -->
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <form method="post" action="/Cart/Add" id="cartForm">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <!-- Quantity selector -->
                    <div style="margin-bottom:1.5rem;">
                        <p style="font-size:0.62rem; text-transform:uppercase;
                            letter-spacing:2px; margin-bottom:0.6rem;
                            color:var(--grey-text);">
                            Quantity
                        </p>
                        <div style="display:inline-flex; align-items:center;
                            border:1px solid var(--grey-mid);">
                            <button type="button" id="qtyMinus"
                                    style="width:38px; height:38px; background:none;
                                border:none; cursor:pointer; font-size:1rem;">
                                −
                            </button>
                            <input type="number" name="quantity" id="qtyInput"
                                   value="1" min="1" max="99"
                                   style="width:44px; height:38px; border:none;
                            border-left:1px solid var(--grey-mid);
                            border-right:1px solid var(--grey-mid);
                            text-align:center; font-size:0.85rem;
                            outline:none; font-family:'Inter',sans-serif;
                            -moz-appearance:textfield;" />
                            <button type="button" id="qtyPlus"
                                    style="width:38px; height:38px; background:none;
                                border:none; cursor:pointer; font-size:1rem;">
                                +
                            </button>
                        </div>
                    </div>

                    <!-- Add to Cart button -->
                    <button type="submit" id="addToCartBtn"
                            style="width:100%; padding:15px;
                        background:var(--black); color:white;
                        border:none; font-size:0.68rem;
                        text-transform:uppercase; letter-spacing:3px;
                        cursor:pointer; font-family:'Inter',sans-serif;
                        transition:background 0.3s;">
                        <i class="bi bi-bag me-2"></i> Add to Cart
                    </button>
                </form>
            }
            else
            {
                <a href="/Account/Login"
                       style="display:block; text-align:center; padding:15px;
                    background:var(--black); color:white; text-decoration:none;
                    font-size:0.68rem; text-transform:uppercase; letter-spacing:3px;
                    font-family:'Inter',sans-serif;">
                    Login to Purchase
                </a>
            }

            <!-- Accordion details -->
            <div style="margin-top:2rem; border-top:1px solid var(--grey-mid);">

                <div onclick="toggleDetail('details')"
                     style="padding:1rem 0; border-bottom:1px solid var(--grey-mid);
                    cursor:pointer; display:flex; justify-content:space-between;
                    align-items:center; user-select:none;">
                    <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:2px;">
                        Product Details
                    </span>
                    <i class="bi bi-plus" id="icon-details"
                       style="font-size:0.9rem; color:var(--grey-text);"></i>
                </div>
                <div id="details"
                     style="display:none; padding:1rem 0;
                    border-bottom:1px solid var(--grey-mid);
                    font-size:0.82rem; line-height:2; color:#666;">
                    <span style="text-transform:uppercase; letter-spacing:1px; font-size:0.68rem;">
                        Brand:
                    </span> @Model.Brand<br />
                    <span style="text-transform:uppercase; letter-spacing:1px; font-size:0.68rem;">
                        Category:
                    </span> @Model.Category?.Name<br />
                    <span style="text-transform:uppercase; letter-spacing:1px; font-size:0.68rem;">
                        Status:
                    </span> @(Model.IsAvailable ? "In Stock" : "Out of Stock")
                </div>

                <div onclick="toggleDetail('shipping')"
                     style="padding:1rem 0; border-bottom:1px solid var(--grey-mid);
                    cursor:pointer; display:flex; justify-content:space-between;
                    align-items:center; user-select:none;">
                    <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:2px;">
                        Shipping & Returns
                    </span>
                    <i class="bi bi-plus" id="icon-shipping"
                       style="font-size:0.9rem; color:var(--grey-text);"></i>
                </div>
                <div id="shipping"
                     style="display:none; padding:1rem 0;
                    border-bottom:1px solid var(--grey-mid);
                    font-size:0.82rem; line-height:2; color:#666;">
                    Free shipping on orders over $150.<br />
                    Standard delivery 3–5 business days.<br />
                    Free returns within 30 days.
                </div>

            </div>

        </div>
    </div>
</div>

<script>
    // ─── LENS ZOOM — only the area inside the lens square gets magnified ─
    // How it works:
    // 1. Canvas element overlays the image
    // 2. On mouse move — draw only the small region under the lens onto canvas
    // 3. That region is stretched to fill the lens box = magnification effect
    // 4. Original image stays untouched underneath

    const container = document.getElementById('imgContainer');
    const mainImg   = document.getElementById('mainImg');
    const lens      = document.getElementById('lens');

    // zoom factor inside the lens
    const ZOOM      = 1;

    // lens size in pixels — must match CSS width/height of #lens
    const LENS_W    = 140;
    const LENS_H    = 140;

    // create a canvas that sits on top of the image
    // canvas lets us draw a magnified region pixel by pixel
    const canvas    = document.createElement('canvas');
    canvas.width    = LENS_W;
    canvas.height   = LENS_H;
    canvas.style.cssText = `
        position:absolute;
        width:${LENS_W}px;
        height:${LENS_H}px;
        pointer-events:none;
        display:none;
        transform:translate(-50%, -50%);
        border:1px solid rgba(0,0,0,0.25);
        z-index:10;
    `;
    container.appendChild(canvas);

    const ctx = canvas.getContext('2d');

    // wait for image to fully load before we can draw from it
    // if image already loaded this fires immediately
    mainImg.addEventListener('load', () => {}, { once: true });

    container.addEventListener('mouseenter', () => {
        lens.style.display   = 'none'; // hide old lens div — canvas replaces it
        canvas.style.display = 'block';
    });

    container.addEventListener('mouseleave', () => {
        canvas.style.display = 'none';
    });

    container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();

        // cursor position inside container in pixels
        const cursorX = e.clientX - rect.left;
        const cursorY = e.clientY - rect.top;

        // move canvas to cursor position
        canvas.style.left = cursorX + 'px';
        canvas.style.top  = cursorY + 'px';

        // how big is the source region we read from the image
        // smaller sourceW/H = more zoom (we read fewer pixels and stretch them)
        const sourceW = LENS_W / ZOOM;
        const sourceH = LENS_H / ZOOM;

        // source top-left corner — centered on cursor
        // we read a sourceW x sourceH region from the image
        const sourceX = (cursorX / rect.width)  * mainImg.naturalWidth  - sourceW / 2;
        const sourceY = (cursorY / rect.height) * mainImg.naturalHeight - sourceH / 2;

        // clear previous frame
        ctx.clearRect(0, 0, LENS_W, LENS_H);

        // draw the source region stretched to fill the entire lens canvas
        // drawImage(image, sx, sy, sWidth, sHeight, dx, dy, dWidth, dHeight)
        // sx,sy = where to start reading from the source image
        // sWidth,sHeight = how much of the source to read
        // dx,dy = where to draw on canvas (0,0 = top left)
        // dWidth,dHeight = how big to draw it on canvas = LENS size = magnification
        ctx.drawImage(
            mainImg,
            sourceX, sourceY,   // source top-left
            sourceW, sourceH,   // source region size
            0, 0,               // destination top-left on canvas
            LENS_W, LENS_H      // destination size = stretched = zoomed
        );
    });

    // ─── QUANTITY BUTTONS ────────────────────────────────────────────
    const qtyInput = document.getElementById('qtyInput');
    const qtyMinus = document.getElementById('qtyMinus');
    const qtyPlus  = document.getElementById('qtyPlus');

    if (qtyMinus && qtyPlus && qtyInput) {
        qtyMinus.addEventListener('click', () => {
            const v = parseInt(qtyInput.value);
            if (v > 1) qtyInput.value = v - 1;
        });
        qtyPlus.addEventListener('click', () => {
            const v = parseInt(qtyInput.value);
            if (v < 99) qtyInput.value = v + 1;
        });
    }

    // ─── ADD TO CART FEEDBACK ────────────────────────────────────────
    const cartForm = document.getElementById('cartForm');
    const addBtn   = document.getElementById('addToCartBtn');

    if (cartForm && addBtn) {
        cartForm.addEventListener('submit', () => {
            addBtn.innerHTML        = '<i class="bi bi-check me-2"></i> Added!';
            addBtn.style.background = '#2d2d2d';
        });
    }

    // ─── ACCORDION ───────────────────────────────────────────────────
    function toggleDetail(id) {
        const panel = document.getElementById(id);
        const icon  = document.getElementById('icon-' + id);
        const isOpen = panel.style.display !== 'none';
        panel.style.display = isOpen ? 'none'       : 'block';
        icon.className      = isOpen ? 'bi bi-plus'  : 'bi bi-dash';
    }
</script>