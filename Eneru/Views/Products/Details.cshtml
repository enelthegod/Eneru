@model Eneru.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container">
    <a href="/Products" class="text-muted text-decoration-none d-inline-flex align-items-center gap-1 mb-4">
        <i class="bi bi-arrow-left"></i> Back to catalog
    </a>

    <div class="row g-5">

        <!-- Product image -->
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="img-fluid w-100"
                 style="height:500px; object-fit:cover; background:#f0f0f0;" />
        </div>

        <!-- Product info -->
        <div class="col-md-6">
            <p class="text-muted text-uppercase" style="letter-spacing:1px; font-size:0.85rem;">
                @Model.Brand
            </p>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <p class="text-muted mb-3">@Model.Category?.Name</p>
            <h3 class="fw-bold mb-4">$@Model.Price.ToString("0.00")</h3>
            <p class="text-muted mb-4">@Model.Description</p>

            @if (Context.Session.GetInt32("UserId") != null)
            {
                <form method="post" action="/Cart/Add">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="d-flex gap-3 align-items-center mb-3">
                        <input type="number" name="quantity" value="1"
                               min="1" max="99"
                               class="form-control"
                               style="width:80px;" />
                        <button type="submit" class="btn btn-dark flex-grow-1">
                            <i class="bi bi-bag-plus"></i> Add to Cart
                        </button>
                    </div>
                </form>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-dark w-100">
                    Login to add to cart
                </a>
            }
        </div>
    </div>
</div>