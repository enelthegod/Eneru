@model List<Eneru.Models.Product>

@{
    ViewData["Title"] = "Catalog";
}

<!-- PAGE HEADER -->
<div style="border-bottom:1px solid var(--grey-mid); padding:2.5rem 0 1.5rem;">
    <div class="container">
        <h1 style="font-family:'Cormorant Garamond',serif; font-size:2.5rem; font-weight:300; letter-spacing:4px; margin-bottom:1.5rem; text-transform:uppercase;">
            @(ViewBag.CurrentCategory != null
                ? ViewBag.CurrentCategory.ToString().ToUpper()
                : "All Products")
        </h1>

        <!-- HORIZONTAL CATEGORY FILTER — like Farfetch -->
        <div class="d-flex gap-3 flex-wrap align-items-center">
            <a href="/Products"
                   style="font-size:0.7rem; text-transform:uppercase; letter-spacing:2px; text-decoration:none; padding-bottom:2px; color:var(--black);
                @(ViewBag.CurrentCategory == null ? "border-bottom:2px solid var(--black); font-weight:500;" : "color:var(--grey-text);")">
                All
            </a>
            @foreach (var cat in ViewBag.Categories as List<Eneru.Models.Category>)
            {
                <a href="/Products?category=@cat.Slug"
                       style="font-size:0.7rem; text-transform:uppercase; letter-spacing:2px; text-decoration:none; padding-bottom:2px;
                    @(ViewBag.CurrentCategory == cat.Slug ? "border-bottom:2px solid var(--black); color:var(--black); font-weight:500;" : "color:var(--grey-text);")">
                    @cat.Name
                </a>
            }

            <!-- Search form inline with filters -->
            <form method="get" action="/Products" class="ms-auto d-flex gap-2">
                @if (ViewBag.CurrentCategory != null)
                {
                    <!-- preserve category when searching -->
                    <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
                }
                <input type="text"
                       name="search"
                       value="@ViewBag.CurrentSearch"
                       placeholder="Search..."
                       style="border:none; border-bottom:1px solid var(--grey-mid); outline:none; font-size:0.8rem; padding:4px 8px; width:180px; font-family:'Inter',sans-serif;" />
                <button type="submit"
                        style="background:none; border:none; cursor:pointer; color:var(--grey-text);">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<div class="container" style="padding:3rem 1rem;">

    <!-- EMPTY STATE -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p style="font-size:0.8rem; text-transform:uppercase; letter-spacing:2px; color:var(--grey-text);">
                No products found
            </p>
            <a href="/Products" class="btn-eneru" style="margin-top:1rem;">
                Clear Filters
            </a>
        </div>
    }
    else
    {
        <!-- PRODUCT COUNT -->
        <p style="font-size:0.7rem; text-transform:uppercase; letter-spacing:2px; color:var(--grey-text); margin-bottom:2rem;">
            @Model.Count item@(Model.Count != 1 ? "s" : "")
            <!-- shows "1 item" or "8 items" correctly -->
        </p>

        <!-- PRODUCT GRID -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="product-card">
                        <a href="/Products/Details/@product.Id" class="text-decoration-none d-block">
                            <div class="img-wrap">
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            </div>
                        </a>
                        <div class="card-info">
                            <p class="card-brand">@product.Brand</p>
                            <p class="card-name">@product.Name</p>
                            <p class="card-price">$@product.Price.ToString("0.00")</p>
                            <a href="/Products/Details/@product.Id"
                                   class="btn-eneru"
                                   style="padding:8px 20px; font-size:0.65rem; display:block; text-align:center; margin-top:8px;">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>