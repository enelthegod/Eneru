@model List<Eneru.Models.Product>

@{
    ViewData["Title"] = "Catalog";
}

<div class="container">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-2 mb-4">
            <h6 class="text-uppercase fw-bold mb-3" style="letter-spacing:1px;">Categories</h6>
            <ul class="list-unstyled">
                <li class="mb-2">
                    <a href="/Products"
                           class="text-decoration-none @(ViewBag.CurrentCategory == null ? "fw-bold" : "text-muted")">
                        All
                    </a>
                </li>
                @foreach (var cat in ViewBag.Categories as List<Eneru.Models.Category>)
                {
                    <li class="mb-2">
                        <a href="/Products?category=@cat.Slug"
                               class="text-decoration-none @(ViewBag.CurrentCategory == cat.Slug ? "fw-bold" : "text-muted")">
                            @cat.Name
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-lg-10">

            <!-- Search bar -->
            <form method="get" action="/Products" class="mb-4">
                <div class="input-group">
                    <input type="text"
                           name="search"
                           value="@ViewBag.CurrentSearch"
                           placeholder="Search products or brands..."
                           class="form-control" />
                    <button type="submit" class="btn btn-dark">Search</button>
                </div>
            </form>

            <!-- Product grid -->
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted">No products found.</p>
                    <a href="/Products" class="btn btn-dark">Clear filters</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card product-card h-100">
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="card-img-top" />
                                <div class="card-body">
                                    <p class="text-muted mb-1" style="font-size:0.8rem;">
                                        @product.Brand
                                    </p>
                                    <h6 class="card-title mb-1">@product.Name</h6>
                                    <p class="fw-bold mb-3">$@product.Price.ToString("0.00")</p>
                                    <a href="/Products/Details/@product.Id"
                                           class="btn btn-dark w-100">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>