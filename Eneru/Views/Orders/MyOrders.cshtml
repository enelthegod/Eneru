@model List<Eneru.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container" style="max-width:750px;">
    <h4 class="fw-bold text-uppercase mb-4" style="letter-spacing:1px;">My Orders</h4>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-clock-history" style="font-size:3rem; color:#ccc;"></i>
            <p class="text-muted mt-3">No orders yet.</p>
            <a href="/Products" class="btn btn-dark">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="fw-bold mb-0">Order #@order.Id</p>
                            <p class="text-muted mb-0" style="font-size:0.85rem;">
                                @order.CreatedAt.ToString("MMMM dd, yyyy")
                            </p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-dark text-uppercase"
                                  style="letter-spacing:1px; font-size:0.7rem;">
                                @order.Status
                            </span>
                            <p class="fw-bold mb-0 mt-1">
                                $@order.TotalPrice.ToString("0.00")
                            </p>
                        </div>
                    </div>

                    @foreach (var item in order.OrderItems)
                    {
                        <div class="d-flex justify-content-between text-muted border-top pt-2 mt-2"
                             style="font-size:0.85rem;">
                            <span>@item.Product!.Name × @item.Quantity</span>
                            <span>
                                $@((item.PriceAtPurchase * item.Quantity).ToString("0.00"))
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>