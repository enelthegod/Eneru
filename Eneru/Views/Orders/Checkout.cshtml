@model List<Eneru.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<div class="container" style="max-width:650px;">
    <h4 class="fw-bold text-uppercase mb-4" style="letter-spacing:1px;">
        Order Summary
    </h4>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            @foreach (var item in Model)
            {
                <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                    <img src="@item.Product!.ImageUrl"
                         alt="@item.Product.Name"
                         style="width:70px; height:70px; object-fit:cover; background:#f0f0f0;" />
                    <div class="flex-grow-1">
                        <p class="text-muted mb-0" style="font-size:0.8rem;">
                            @item.Product.Brand
                        </p>
                        <p class="fw-bold mb-0">@item.Product.Name</p>
                        <p class="text-muted mb-0" style="font-size:0.85rem;">
                            Qty: @item.Quantity
                        </p>
                    </div>
                    <p class="fw-bold mb-0">
                        $@((item.Product.Price * item.Quantity).ToString("0.00"))
                    </p>
                </div>
            }

            <div class="p-3 d-flex justify-content-between">
                <span class="fw-bold text-uppercase"
                      style="letter-spacing:1px;">Total</span>
                <span class="fw-bold fs-5">
                    $@ViewBag.Total.ToString("0.00")
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <a href="/Cart" class="text-muted text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Cart
        </a>
        <form method="post" action="/Orders/PlaceOrder">
            <button type="submit" class="btn btn-dark px-5"
                    style="text-transform:uppercase; letter-spacing:1px;">
                Place Order
            </button>
        </form>
    </div>
</div>