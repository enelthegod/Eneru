@model List<Eneru.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<div style="padding:2rem 0; border-bottom:1px solid var(--grey-mid);">
    <div class="container">
        <h1 style="font-family:'Cormorant Garamond',serif; font-size:2.2rem;
            font-weight:300; letter-spacing:4px; text-transform:uppercase;">
            Checkout
        </h1>
    </div>
</div>

<div class="container" style="padding:3rem 1rem;">
    <div class="row g-5">

        <!-- LEFT — Order items -->
        <div class="col-lg-7">
            <h6 style="font-size:0.68rem; text-transform:uppercase;
                letter-spacing:3px; margin-bottom:1.5rem;">
                Order Items
            </h6>

            @foreach (var item in Model)
            {
                <div class="d-flex gap-3 align-items-center py-3"
                     style="border-bottom:1px solid var(--grey-mid);">

                    <img src="@item.Product!.ImageUrl"
                         alt="@item.Product.Name"
                         style="width:70px; height:88px;
                    object-fit:cover;
                    background:var(--grey-light);" />

                    <div class="flex-grow-1">
                        <p style="font-size:0.62rem; text-transform:uppercase;
                            letter-spacing:2px; color:var(--grey-text); margin-bottom:2px;">
                            @item.Product.Brand
                        </p>
                        <p style="font-family:'Cormorant Garamond',serif;
                            font-size:1.05rem; margin-bottom:2px;">
                            @item.Product.Name
                        </p>
                        <p style="font-size:0.75rem; color:var(--grey-text); margin:0;">
                            Qty: @item.Quantity
                        </p>
                    </div>

                    <p style="font-size:0.85rem; margin:0; white-space:nowrap;">
                        $@((item.Product.Price * item.Quantity).ToString("0.00"))
                    </p>
                </div>
            }
        </div>

        <!-- RIGHT — Summary and place order -->
        <div class="col-lg-5">
            <div style="background:var(--grey-light); padding:2rem; position:sticky; top:120px;">

                <h6 style="font-size:0.68rem; text-transform:uppercase;
                    letter-spacing:3px; margin-bottom:1.5rem;">
                    Order Summary
                </h6>

                <div style="display:flex; justify-content:space-between;
                    font-size:0.78rem; margin-bottom:0.75rem;">
                    <span style="color:var(--grey-text);">Subtotal</span>
                    <span>$@ViewBag.Total.ToString("0.00")</span>
                </div>

                <div style="display:flex; justify-content:space-between;
                    font-size:0.78rem; padding-bottom:1.5rem; margin-bottom:1.5rem;
                    border-bottom:1px solid var(--grey-mid);">
                    <span style="color:var(--grey-text);">Shipping</span>
                    <span style="color:green;">
                        @(ViewBag.Total >= 150 ? "Free" : "$15.00")
                    </span>
                </div>

                <div style="display:flex; justify-content:space-between; margin-bottom:2rem;">
                    <span style="font-size:0.72rem; text-transform:uppercase; letter-spacing:2px;">
                        Total
                    </span>
                    <span style="font-size:1.1rem;">
                        $@((ViewBag.Total >= 150
                                                    ? ViewBag.Total
                                                    : ViewBag.Total + 15).ToString("0.00"))
                    </span>
                </div>

                <form method="post" action="/Orders/PlaceOrder">
                    <button type="submit" class="btn-eneru"
                            style="width:100%; padding:14px; text-align:center;
                        display:block; cursor:pointer; border:none;">
                        Place Order
                    </button>
                </form>

                <a href="/Cart"
                       style="display:block; text-align:center; margin-top:1rem;
                    font-size:0.65rem; text-transform:uppercase;
                    letter-spacing:2px; color:var(--grey-text); text-decoration:none;">
                    <i class="bi bi-arrow-left me-1"></i> Back to Cart
                </a>

            </div>
        </div>
    </div>
</div>