@model Eneru.Models.Order

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container" style="max-width:600px;">

    <!-- Success header -->
    <div class="text-center mb-5">
        <div class="mb-3">
            <i class="bi bi-check-circle"
               style="font-size:3rem; color:#111;"></i>
        </div>
        <h4 class="fw-bold text-uppercase mb-1" style="letter-spacing:2px;">
            Order Confirmed
        </h4>
        <p class="text-muted">
            Order #@Model.Id ·
            @Model.CreatedAt.ToString("MMMM dd, yyyy")
        </p>
    </div>

    <!-- Order items -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            @foreach (var item in Model.OrderItems)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <div>
                        <p class="fw-bold mb-0">@item.Product!.Name</p>
                        <p class="text-muted mb-0" style="font-size:0.85rem;">
                            Qty: @item.Quantity
                        </p>
                    </div>
                    <p class="fw-bold mb-0">
                        $@((item.PriceAtPurchase * item.Quantity).ToString("0.00"))
                    </p>
                </div>
            }
            <div class="p-3 d-flex justify-content-between">
                <span class="fw-bold text-uppercase"
                      style="letter-spacing:1px;">Total</span>
                <span class="fw-bold fs-5">
                    $@Model.TotalPrice.ToString("0.00")
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 justify-content-center">
        <a href="/Orders/MyOrders" class="btn btn-dark"
               style="text-transform:uppercase; letter-spacing:1px;">
            My Orders
        </a>
        <a href="/Products" class="btn btn-outline-dark"
               style="text-transform:uppercase; letter-spacing:1px;">
            Continue Shopping
        </a>
    </div>
</div>